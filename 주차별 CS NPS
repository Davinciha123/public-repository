const stage = document.getElementById('stage');
function fit(){
  const s = Math.min(window.innerWidth/1280, window.innerHeight/720) * 0.95;
  stage.style.transform = `translate(-50%,-50%) scale(${s})`;
}
window.addEventListener('resize', fit); fit();

/* ============ 2. 슬라이드 네비게이션 ============ */
const slides = Array.from(document.querySelectorAll('.slide'));
const bar = document.getElementById('bar');
const curEl = document.getElementById('cur');
document.getElementById('tot').textContent = slides.length;
let idx = 0;

function show(n){
  idx = Math.max(0, Math.min(slides.length-1, n));
  slides.forEach((s,i)=>s.classList.toggle('active', i===idx));
  curEl.textContent = idx+1;
  bar.style.width = ((idx+1)/slides.length*100) + '%';
  slides[idx].appendChild(bar);          // 진행바를 현재 슬라이드로 이동
  document.getElementById('prev').disabled = (idx===0);
  document.getElementById('next').disabled = (idx===slides.length-1);
  location.hash = 'p' + (idx+1);
}
const nextS = ()=>show(idx+1);
const prevS = ()=>show(idx-1);

document.addEventListener('keydown', e=>{
  switch(e.key){
    case 'ArrowRight': case 'ArrowDown': case 'PageDown': case ' ':
      e.preventDefault(); nextS(); break;
    case 'ArrowLeft': case 'ArrowUp': case 'PageUp':
      e.preventDefault(); prevS(); break;
    case 'Home': e.preventDefault(); show(0); break;
    case 'End':  e.preventDefault(); show(slides.length-1); break;
    case 'f': case 'F':
      if(document.fullscreenElement) document.exitFullscreen();
      else document.documentElement.requestFullscreen();
      break;
  }
});
document.getElementById('next').addEventListener('click', e=>{e.stopPropagation(); nextS();});
document.getElementById('prev').addEventListener('click', e=>{e.stopPropagation(); prevS();});
document.getElementById('viewport').addEventListener('click', e=>{
  (e.clientX < window.innerWidth/2 ? prevS : nextS)();
});
let tx=null;
document.addEventListener('touchstart', e=>{tx=e.changedTouches[0].clientX;}, {passive:true});
document.addEventListener('touchend', e=>{
  if(tx===null) return;
  const d = e.changedTouches[0].clientX - tx;
  if(Math.abs(d)>50){ d<0 ? nextS() : prevS(); }
  tx=null;
}, {passive:true});

