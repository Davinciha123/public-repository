  const tl=[1.82,3.12,3.92,2.41,2.82,2.18,2.55,2.67,2.04,2.59,4.20,2.80,2.00,3.18,6.18,14.78,11.02,2.62];
  const pd=[3.55,4.93,4.79,3.63,3.53,2.23,2.42,2.84,2.18,2.90,4.37,3.95,5.28,3.95,4.23,4.99,4.66,4.29];
  const max=16, svg=frame(host,W,H);
  const x=i=>L+i*(W-L-R)/(labels.length-1), y=v=>H-B-(v/max)*(H-T-B);
  for(let g=0;g<=16;g+=4){
    svg.appendChild(el('line',{x1:L,x2:W-R,y1:y(g),y2:y(g),stroke:'#EFEFEF','stroke-width':1}));
    svg.appendChild(txt(L-7,y(g)+3.5,g,{a:'end',fs:9}));
  }
  svg.appendChild(el('rect',{x:x(14)-6,y:T,width:x(16)-x(14)+12,height:H-T-B,fill:'#C10933',opacity:.06}));
  svg.appendChild(txt((x(14)+x(16))/2,T+11,'이상 급등',{c:'#C10933',fs:9,w:700}));
  const path=d=>d.map((v,i)=>(i?'L':'M')+x(i)+' '+y(v)).join(' ');
  svg.appendChild(el('path',{d:path(pd),fill:'none',stroke:'#1A4F8A','stroke-width':1.8,'stroke-linejoin':'round'}));
  svg.appendChild(el('path',{d:path(tl),fill:'none',stroke:'#C10933','stroke-width':2.4,'stroke-linejoin':'round'}));
  pd.forEach((v,i)=>svg.appendChild(el('circle',{cx:x(i),cy:y(v),r:2,fill:'#1A4F8A'})));
  tl.forEach((v,i)=>{
    const big=v>6;
    svg.appendChild(el('circle',{cx:x(i),cy:y(v),r:big?3.4:2.4,fill:'#C10933'}));
    if(big) svg.appendChild(txt(x(i),y(v)-8,v.toFixed(1),{c:'#C10933',fs:9.5,w:700}));
  });
  labels.forEach((s,i)=>{ if(i%2===0||i>=14) svg.appendChild(txt(x(i),H-11,s,{fs:8.5})); });
})();

/* --- 3-2. 누적 막대 : 구간별 L/T 기여도 --- */
(function(){
  const host=document.getElementById('ch-stack');
  const W=520,H=300,L=32,R=10,T=16,B=34;
  const labels=['25-02','25-04','25-07','25-10','25-12','26-01','26-04','26-05','26-06','26-07'];
  const pd=[3.6,4.8,2.2,2.2,4.4,4.0,4.2,5.0,4.7,4.3];
  const tl=[1.8,3.9,2.2,2.0,4.2,2.8,6.2,14.8,11.0,2.6];
  const dv=[1.0,1.4,1.3,1.2,1.3,1.6,1.2,1.2,1.1,1.4];
  const max=22, svg=frame(host,W,H);
  const bw=(W-L-R)/labels.length, y=v=>H-B-(v/max)*(H-T-B);
  for(let g=0;g<=20;g+=5){
    svg.appendChild(el('line',{x1:L,x2:W-R,y1:y(g),y2:y(g),stroke:'#EFEFEF','stroke-width':1}));
    svg.appendChild(txt(L-7,y(g)+3.5,g,{a:'end',fs:9}));
  }
  labels.forEach((s,i)=>{
    const cx=L+i*bw+bw/2, w=bw*0.56, x0=cx-w/2;
    let acc=0;
    [[pd[i],'#1A4F8A'],[tl[i],'#C10933'],[dv[i],'#E8A9B8']].forEach(([v,c])=>{
      svg.appendChild(el('rect',{x:x0,y:y(acc+v),width:w,height:Math.max(y(acc)-y(acc+v),0.5),fill:c}));
      acc+=v;
    });
    const tot=(pd[i]+tl[i]+dv[i]).toFixed(1);
    svg.appendChild(txt(cx,y(acc)-6,tot,{c:acc>15?'#C10933':'#5C5C5C',fs:9.5,w:700}));
    svg.appendChild(txt(cx,H-12,s,{fs:9}));
  });
  svg.appendChild(el('line',{x1:L,x2:W-R,y1:y(10),y2:y(10),stroke:'#1A7340','stroke-width':1.2,'stroke-dasharray':'5 4'}));
  svg.appendChild(txt(W-R-2,y(10)-5,'목표 10일',{a:'end',c:'#1A7340',fs:9,w:700}));
})();

/* --- 3-3. 막대 차트 : 배차 요일 패턴 --- */
(function(){
  const host=document.getElementById('ch-dow');
  const W=460,H=250,L=30,R=12,T=22,B=30;
  const labels=['월','화','수','목','금','토'];
  const vals=[212,256,244,203,144,56];
  const max=280, svg=frame(host,W,H);
  const bw=(W-L-R)/labels.length, y=v=>H-B-(v/max)*(H-T-B);
  for(let g=0;g<=280;g+=70){
    svg.appendChild(el('line',{x1:L,x2:W-R,y1:y(g),y2:y(g),stroke:'#EFEFEF','stroke-width':1}));
    svg.appendChild(txt(L-6,y(g)+3.5,g,{a:'end',fs:9}));
  }
  labels.forEach((s,i)=>{
    const cx=L+i*bw+bw/2, w=bw*0.5, v=vals[i];
    const peak=(i>=1&&i<=2), low=(i>=4);
    svg.appendChild(el('rect',{x:cx-w/2,y:y(v),width:w,height:H-B-y(v),
      fill: peak?'#C10933' : low?'#D9D9D9' : '#E8A9B8', rx:2}));
    svg.appendChild(txt(cx,y(v)-6,v,{c:peak?'#C10933':'#5C5C5C',fs:10,w:700}));
    svg.appendChild(txt(cx,H-11,s,{fs:10.5,c:'#5C5C5C',w:peak?700:400}));
  });
  svg.appendChild(txt(L+(W-L-R)*0.30,T-6,'주초 집중',{c:'#C10933',fs:9,w:700}));
  svg.appendChild(txt(L+(W-L-R)*0.80,T-6,'금·토 배차 회피',{c:'#9E9E9E',fs:9,w:700}));
})();

