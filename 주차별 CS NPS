  t.textContent=s; return t;
}
function frame(host,W,H){
  const svg=el('svg',{viewBox:`0 0 ${W} ${H}`,preserveAspectRatio:'none'});
  host.innerHTML=''; host.appendChild(svg); return svg;
}

